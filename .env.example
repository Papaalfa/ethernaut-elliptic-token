# Copy to .env and fill in. .env is gitignored — never commit real values.

# Your Ethernaut EllipticToken instance address (from "Get new instance" on the level page)
LEVEL=0x...

# Your own wallet address (must hold a little Sepolia ETH for gas)
MY_ADDRESS=0x...

# A Sepolia RPC endpoint (Alchemy/Infura/etc, or a public one)
RPC_URL=https://...

# Optional — only needed if you use script/fetch_factory_data.py's on-chain
# recon path or otherwise query Etherscan directly. Get one free at
# https://etherscan.io/apis
ETHERSCAN_API_KEY=
